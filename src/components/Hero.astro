---
const logos = [
  { src: "/logos/delphyr.svg", alt: "Delphyr", w: 102, h: 29 },
  { src: "/logos/hearst.svg", alt: "Hearst", w: 122, h: 23 },
  { src: "/logos/qfc.svg", alt: "QFC Fintech Circle", w: 63, h: 28 },
  { src: "/logos/chainstory.svg", alt: "Chainstory", w: 114, h: 28 },
  { src: "/logos/zivoe.svg", alt: "Zivoe", w: 81, h: 28 },
  { src: "/logos/coinbound.svg", alt: "Coinbound", w: 107, h: 28 },
  { src: "/logos/connectwise.svg", alt: "ConnectWise", w: 70, h: 28 },
  { src: "/logos/halbo.svg", alt: "Halborn", w: 141, h: 14.5 },
];
---
<section class="hero" data-hero>
  <!-- Layers: 1 idle video · 2 transition frames · 3 cyan glow · 4 white -->
  <div class="hero__bg" aria-hidden="true">
    <video
      class="hero__video"
      muted
      loop
      playsinline
      preload="none"
      poster="/hero/hero-poster.jpg"
      data-src-lg-webm="/hero/hero-idle.webm"
      data-src-lg-mp4="/hero/hero-idle.mp4"
      data-src-sm-mp4="/hero/hero-idle-sm.mp4"
    ></video>
    <canvas class="hero__seq"></canvas>
    <div class="hero__glow"></div>
    <div class="hero__shade"></div>
    <div class="hero__fade"></div>
    <div class="hero__white"></div>
  </div>

  <div class="hero__inner">
    <p class="overline hero__eyebrow">Mara — design, branding &amp; front-end studio</p>
    <h1 class="hero__title">Make your startup<br /> impossible to ignore.</h1>
    <div class="hero__actions">
      <a href="#contact" class="btn btn--md btn--primary">Contact us</a>
      <a href="#work" class="btn btn--md btn--ghost">See our work</a>
    </div>

    <div class="logos">
      <p class="sr-only">Trusted by</p>
      <div class="logos__track">
        {[0, 1].map((copy) => (
          <ul class="logos__row" aria-hidden={copy === 1 ? "true" : undefined}>
            {logos.map((l) => (
              <li><img src={l.src} alt={copy === 0 ? l.alt : ""} width={l.w} height={l.h} style={`--h:${l.h}px`} loading="lazy" /></li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    --charge: 0;
    --gx: 50%;
    --gy: 45%;
    position: relative;
    /* exactly one screen under the sticky header, so the pinned light fills the viewport */
    height: calc(100svh - var(--header-h, 64px));
    min-height: 560px;
    display: flex;
    overflow: hidden;
    background: var(--c-black);
  }
  .hero__bg {
    position: absolute; inset: 0;
    pointer-events: none;
    background: #000 url("/hero/hero-poster.jpg") center / cover no-repeat;
  }
  .hero__bg > * { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .hero__video {
    object-fit: cover; object-position: center;
    filter:
      brightness(calc(1 + var(--charge) * .35))
      saturate(calc(1 + var(--charge) * .45))
      contrast(calc(1 + var(--charge) * .06));
    will-change: filter;
  }
  .hero__seq { opacity: 0; }
  .hero__glow {
    mix-blend-mode: screen;
    opacity: calc(var(--charge) * .9);
    background:
      radial-gradient(42vmax 42vmax at var(--gx) var(--gy), rgba(121, 242, 255, .28), rgba(121, 242, 255, 0) 70%),
      radial-gradient(120% 70% at 50% 55%, rgba(93, 189, 199, .16), rgba(93, 189, 199, 0) 70%);
  }
  .hero__fade {
    top: auto !important; height: 180px !important;
    background: linear-gradient(0deg, #000 0%, rgba(0,0,0,0) 100%);
  }
  /* readability: dark from the bottom-left corner (where the text sits), dissolving towards the top-right */
  .hero__shade {
    background: linear-gradient(to top right, rgba(0, 0, 0, .88) 0%, rgba(0, 0, 0, .7) 25%, rgba(0, 0, 0, .3) 50%, rgba(0, 0, 0, 0) 72%);
  }
  .hero__white { background: #fff; opacity: 0; }

  .hero__inner {
    position: relative; z-index: 2;
    width: 100%; max-width: var(--max); margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex; flex-direction: column; justify-content: flex-end;
  }
  .hero__eyebrow { margin: 0 0 20px; color: var(--c-gray-300); }
  .hero__title {
    margin: 0;
    max-width: 880px;
    font-size: var(--t-display);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .hero__actions { display: flex; gap: 16px; margin-top: 40px; }

  .logos {
    margin-top: 44px;
    padding: 24px 0;
    border-top: 1px solid var(--c-charcoal);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 100px, #000 calc(100% - 100px), transparent 100%);
            mask-image: linear-gradient(90deg, transparent 0, #000 100px, #000 calc(100% - 100px), transparent 100%);
  }
  .logos__track {
    display: flex; width: max-content;
    animation: marquee 40s linear infinite;
  }
  .logos:hover .logos__track { animation-play-state: paused; }
  .logos__row {
    display: flex; align-items: center; gap: 80px;
    margin: 0; padding: 0 40px; list-style: none;
  }
  .logos__row img { height: var(--h, 28px); width: auto; opacity: .6; }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .logos__track { animation: none; }
    .hero__video, .hero__seq, .hero__glow { display: none; }
  }

  @media (max-width: 1100px) {
    .hero__title { font-size: 48px; }
  }
  @media (max-width: 768px) {
    .hero__title { font-size: 40px; }
    .hero__actions { margin-top: 32px; }
    .logos__row { gap: 48px; padding: 0 24px; }
    .logos__row img { height: calc(var(--h, 28px) * .8); }
  }
  @media (max-width: 480px) {
    .hero__inner { padding: 0 16px; }
    .hero__title { font-size: 34px; }
    .hero__title br { display: none; }
    .hero__actions { flex-direction: column; }
    .hero__actions .btn { width: 100%; }
  }
</style>

<script>
  import { initHeroMotion } from "../scripts/hero-motion";
  const cleanup = initHeroMotion();
  document.addEventListener("astro:before-swap", () => cleanup?.(), { once: true });
</script>
