---
// IBM (Carbon) icons from src/icons, inlined so they take the text colour.
// Usage: <Icon name="Arrow--up-right" size={16} />
interface Props { name: string; size?: number; class?: string }
const { name, size = 16, class: cls } = Astro.props;
const files = import.meta.glob<string>("../icons/*.svg", { query: "?raw", import: "default", eager: true });
const raw = files[`../icons/${name}.svg`];
if (!raw) throw new Error(`Icon not found: ${name}`);
const inner = raw
  .replace(/^[\s\S]*?<svg[^>]*>/, "")
  .replace(/<\/svg>\s*$/, "")
  .replace(/<rect[^>]*fill-opacity="0\.01"[^>]*\/>/g, "") // Carbon's invisible bounding box
  .replace(/fill="#161616"/g, 'fill="currentColor"');
const vb = raw.match(/viewBox="([^"]+)"/)?.[1] ?? "0 0 16 16";
---
<svg class={cls} width={size} height={size} viewBox={vb} fill="none" aria-hidden="true" focusable="false" set:html={inner} />
