---
// Contact section — the last section before the footer (replaces the Final CTA).
import ContactPanel from "./ContactPanel.astro";
---
<section class="contact" id="contact" aria-labelledby="cs-title" data-contact>
  <div class="contact__bg" aria-hidden="true"></div>
  <ContactPanel context="section" />
</section>

<style>
  .contact {
    position: relative;
    z-index: 1;
    overflow: hidden;
    /* one screen under the header at most */
    padding: 56px 56px;
    min-height: min(680px, calc(100svh - var(--header-h, 64px)));
    display: flex;
    align-items: center;
    background: #000100;
  }
  .contact__bg {
    position: absolute;
    inset: 0;
    background: #000100 url("/contact/contact-bg.jpg") no-repeat 50% 100% / cover;
  }
  @media (min-width: 1441px) {
    .contact__bg { background-size: 100% auto; }
  }
  @media (max-width: 1100px) {
    .contact { padding: 80px 32px; min-height: 0; }
    .contact__bg { background-size: 1440px auto; }
  }
  @media (max-width: 768px) {
    .contact { padding: 72px 16px; }
    .contact__bg { background-image: url("/contact/contact-bg-sm.jpg"); background-size: 900px auto; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  const section = document.querySelector<HTMLElement>("[data-contact]");
  if (section && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    gsap
      .timeline({ scrollTrigger: { trigger: section, start: "top 72%", toggleActions: "play none none reverse" } })
      .fromTo(section.querySelector(".contact__bg"), { opacity: 0, scale: 1.06 }, { opacity: 1, scale: 1, duration: 1.4, ease: "power2.out" })
      .fromTo(section.querySelectorAll("[data-c-split] .line > span"), { yPercent: 105, opacity: 0, filter: "blur(8px)" }, { yPercent: 0, opacity: 1, filter: "blur(0px)", duration: 0.75, stagger: 0.09, ease: "power3.out" }, 0.15)
      .fromTo(section.querySelectorAll("[data-c-fade]"), { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.6, stagger: 0.08 }, 0.3)
      .fromTo(section.querySelector("[data-c-card]"), { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.9, ease: "power3.out" }, 0.25)
      .fromTo(section.querySelectorAll(".cform > *:not([type=hidden]):not(.cform__hp)"), { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.5, stagger: 0.05, ease: "power2.out" }, 0.4);
  }
</script>
