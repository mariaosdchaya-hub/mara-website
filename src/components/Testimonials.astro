---
import Icon from "./Icon.astro";
// Testimonials — featured client stories (Teamway-style: photo · quote · result).
// Copy and photos from mara.ink ("Trusted by 100+ companies…"); photos are served from the studio's R2 bucket.
// TODO: the `metric` values are PLACEHOLDERS until real results are confirmed with each client.
const R2 = "https://pub-263bccec62e448a7ac7b14fc514bbc26.r2.dev/";
const stories = [
  {
    name: "Lee Silverstone",
    role: "Founder, ZofiQ (acquired by ConnectWise)",
    company: "ZofiQ",
    logo: null,
    photo: "1737780663382.jpeg",
    crop: true, // the source has an "Adobe Firefly" mark in the bottom-left corner: crop it out
    text: "We worked with Mara for a year and a half, up to our successful acquisition. We’re very happy with the team — highly professional and instrumental in helping us overcome every challenge along the way.",
    metric: { prefix: "", value: 18, suffix: "mo", caption: "of partnership, up to the acquisition." }, // placeholder
  },
  {
    name: "Michel Abdel Malek",
    role: "Founder, Delphyr",
    company: "Delphyr",
    logo: "/logos/delphyr.svg",
    photo: "Michel-Abdel-Malek-1920.jpg",
    text: "We brought Mara in as a design partner. They always ask the right questions, challenge decisions when needed, and help us build things that actually make sense, not just look good.",
    metric: { prefix: "", value: 8, suffix: "wk", caption: "from idea to a clickable MVP." }, // placeholder
  },
  {
    name: "Matthew Paterson",
    role: "Founder, Minisport",
    company: "Minisport",
    logo: null,
    photo: "1758233917622.jpeg",
    text: "Mara led a strategic redesign across our entire business — from branding to product and marketing. We’re very happy with the results and look forward to continuing our partnership.",
    metric: { prefix: "+", value: 64, suffix: "%", caption: "more bookings after the redesign." }, // placeholder
  },
];
---
<section class="testi" id="testimonials" data-testi>
  <div class="testi__inner">
    <div class="testi__head">
      <div>
        <p class="sec-label" data-fade>( Hear it from our clients )</p>
        <h2 class="testi__title" data-split>
          <span class="line"><span>Trusted by 100+ companies</span></span>
          <span class="line"><span>to design, build and raise.</span></span>
        </h2>
      </div>
      <p class="testi__lead" data-fade>From first sketch to acquisition, a few of the teams we’ve built with.</p>
    </div>

    <ul class="stories" role="list">
      {stories.map((s, i) => (
        <li class="story" data-story style={`--i:${i}`}>
          <div class:list={["story__photo", { "story__photo--crop": s.crop }]} data-story-photo>
            <img src={R2 + s.photo} alt={s.name} loading="lazy" decoding="async" />
          </div>
          <div class="story__body">
            <blockquote class="story__quote" data-story-text>{s.text}</blockquote>
            <div class="story__who" data-story-text>
              <span class="story__logo" aria-hidden="true">
                {s.logo ? <img src={s.logo} alt="" /> : <span>{s.company.slice(0, 1)}</span>}
              </span>
              <span class="story__person">
                <span class="story__name">{s.name}</span>
                <span class="story__role">{s.role}</span>
              </span>
            </div>
          </div>
          <span class="story__rule" aria-hidden="true" data-story-rule></span>
          <div class="story__metric">
            <span class="story__num">{s.metric.prefix}<span data-count={s.metric.value}>{s.metric.value}</span><span class="story__unit">{s.metric.suffix}</span></span>
            <span class="story__caption">{s.metric.caption}</span>
          </div>
        </li>
      ))}
    </ul>

    <div class="testi__cta" data-cta>
      <p class="testi__cta-text">Your product could be the next story.</p>
      <a href="#contact" class="testi__btn">Let’s talk <Icon name="Arrow--up-right" size={16} /></a>
    </div>
  </div>
</section>

<style>
  .testi { position: relative; z-index: 1; background: #fff; color: #0d221a; }
  .testi__inner { max-width: 1440px; margin: 0 auto; padding: var(--sec-pad); display: flex; flex-direction: column; gap: 40px; }

  .testi__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; }
  .testi__lead { margin: 0; max-width: 380px; color: #6b6b70; font-size: var(--t-lead); line-height: 1.5; }
  .testi__title { margin: 0; font-size: var(--t-h2); font-weight: 400; line-height: 1.1; letter-spacing: -0.02em; }
  .line { display: block; overflow: hidden; padding-bottom: .08em; margin-bottom: -.08em; }
  .line > span { display: inline-block; }

  .stories { width: 100%; max-width: 1040px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; padding: 0; list-style: none; }
  .story {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr) 1px 200px;
    gap: 0 32px;
    padding: 14px;
    background: #f6f6f7;
    border: 1px solid #ececef;
    transform-origin: 50% 0;
  }
  .story__photo { position: relative; aspect-ratio: 180 / 200; overflow: hidden; background: #e6e6e9; }
  .story__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; filter: grayscale(1) contrast(1.05); transform-origin: 50% 0; }
  /* taller than the frame and pinned to the top: the bottom strip (with the watermark) falls outside */
  .story__photo--crop img { height: 122%; object-position: 62% 0; }
  .story__body { display: flex; flex-direction: column; justify-content: space-between; gap: 24px; padding: 10px 0; }
  .story__quote { margin: 0; max-width: 560px; font-size: 18px; line-height: 1.45; color: #141414; }
  .story__who { display: flex; align-items: center; gap: 14px; }
  .story__logo {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    background: #0d221a;
    color: #79f2ff;
    font-size: 15px;
    font-weight: 500;
    overflow: hidden;
  }
  .story__logo img { width: 70%; height: auto; filter: brightness(0) invert(1); }
  .story__person { display: flex; flex-direction: column; gap: 2px; }
  .story__name { font-size: 14px; font-weight: 500; color: #141414; }
  .story__role { font-size: 13px; color: #6b6b70; }
  .story__rule { align-self: stretch; margin: 14px 0; background: #dcdce1; transform-origin: 50% 0; }
  .story__metric { display: flex; flex-direction: column; justify-content: flex-end; gap: 10px; padding: 14px 4px; }
  .story__num { font-size: 56px; font-weight: 400; line-height: .9; letter-spacing: -0.04em; color: #141414; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .story__unit { font-size: .4em; letter-spacing: -0.01em; margin-left: 4px; }
  .story__caption { font-size: 13px; color: #6b6b70; }

  .testi__cta { width: 100%; max-width: 1040px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; gap: 24px; padding-top: 8px; }
  .testi__cta-text { margin: 0; font-size: 16px; color: #141414; }
  .testi__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 48px;
    padding: 0 24px;
    background: #141414;
    color: #fff;
    font-size: 15px;
    font-weight: 500;
    transition: background-color .2s, color .2s;
  }
  .testi__btn:hover { background: #79f2ff; color: #141414; }

  /* desktop: cards stack on scroll — each one sticks under the header and the next slides over it */
  /* desktop: the section pins under the header (title, subtitle and CTA stay in view)
     and the stories stack inside a fixed stage — see testimonials-motion.ts */
  @media (min-width: 769px) {
    .testi.is-pinned .testi__inner {
      min-height: calc(100svh - var(--header-h, 64px));
      justify-content: center;
      padding-top: 40px;
      padding-bottom: 40px;
      gap: 32px;
    }
    .testi.is-pinned .stories { position: relative; height: var(--stage-h, auto); }
    .testi.is-pinned .story { position: absolute; top: 0; left: 0; right: 0; }
  }

  @media (max-width: 1100px) {
    .testi__head { flex-direction: column; align-items: flex-start; gap: 16px; }
    .story { grid-template-columns: 180px minmax(0, 1fr) 1px 180px; gap: 0 28px; }
    .story__quote { font-size: 17px; }
    .story__num { font-size: 48px; }
  }
  @media (max-width: 768px) {
    .testi__inner { gap: 32px; }
    .story { grid-template-columns: 1fr; gap: 20px; padding: 14px; }
    .story__photo { aspect-ratio: 4 / 3; }
    .story__body { padding: 0 4px; gap: 20px; }
    .story__quote { font-size: 16px; }
    .story__rule { height: 1px; margin: 0; transform-origin: 0 50%; }
    .story__metric { flex-direction: row; align-items: baseline; justify-content: flex-start; gap: 14px; padding: 0 4px 6px; }
    .story__num { font-size: 44px; }
    .testi__cta { flex-direction: column; align-items: flex-start; }
  }
</style>

<script>
  import { initTestimonials } from "../scripts/testimonials-motion";
  const cleanup = initTestimonials();
  document.addEventListener("astro:before-swap", () => cleanup?.(), { once: true });
</script>
