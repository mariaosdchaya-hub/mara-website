---
// Testimonials — Quote + Photos (Figma 4202:2861). Copy and photos from mara.ink ("Trusted by 100+ companies…").
// Photos are served from the studio's existing R2 bucket.
const R2 = "https://pub-263bccec62e448a7ac7b14fc514bbc26.r2.dev/";
const items = [
  { name: "Viktor Sander", role: "Co-Founder of SocialSelf", photo: "images.jpeg", pos: "50% 30%",
    text: "They helped us to create and optimize our marketing materials and landing pages, which helped us to grow 3 times within a 6-month period. I was particularly impressed by their consistent ability to meet deadlines while maintaining the highest industry standards." },
  { name: "Lee Silverstone", role: "Founder of ZofiQ (acquired by ConnectWise)", photo: "1737780663382.jpeg", pos: "50% 30%",
    text: "We worked with Mara for a year and a half, up to our successful acquisition. We’re very happy with the team — highly professional and instrumental in helping us overcome every challenge along the way." },
  { name: "Michel Abdel Malek", role: "Founder of Delphyr", photo: "Michel-Abdel-Malek-1920.jpg", pos: "50% 30%",
    text: "We brought Mara in as a design partner. They always ask the right questions, challenge decisions when needed, and help us build things that actually make sense, not just look good. Recommend." },
  { name: "Matthew Paterson", role: "Founder of Minisport.hk", photo: "1758233917622.jpeg", pos: "50% 30%",
    text: "Mara led a strategic redesign across our entire business — from branding to product and marketing. We’re very happy with the results and look forward to continuing our partnership." },
  { name: "Michael McEwen", role: "CEO at RepFlow", photo: "1748498843139.jpeg", pos: "50% 30%",
    text: "Mara has a fantastic eye for design, works very collaboratively, and delivers on time and as promised. Highly recommended." },
  { name: "Sasha Krecinic", role: "Founder of SkipUp", photo: "1615519427076.jpeg", pos: "50% 30%",
    text: "I’m really impressed with the work you’ve done on this project. The interface looks clean, modern, and highly intuitive. You’ve managed to balance aesthetics with usability, which makes the product not only visually appealing but also very easy to navigate." },
];
const total = String(items.length).padStart(2, "0");
---
<section class="testi" id="testimonials" data-testi aria-label="What clients say">
  <div class="testi__inner">
    <div class="rolodex" aria-hidden="true" data-rolodex>
      {items.map((t, i) => (
        <div class="rolodex__card" data-tcard style={`--i:${i}`}>
          <img src={R2 + t.photo} alt="" loading="lazy" decoding="async" style={`object-position:${t.pos}`} />
        </div>
      ))}
      <div class="rolodex__fade"></div>
    </div>

    <div class="testi__body">
      <ul class="testi__quotes" role="list">
        {items.map((t, i) => (
          <li class:list={["quote", { "is-active": i === 0 }]} data-quote aria-hidden={i === 0 ? undefined : "true"}>
            <blockquote class="quote__text" data-part>“{t.text}”</blockquote>
            <p class="quote__who" data-part>
              <span class="quote__name">{t.name}</span>
              <span class="quote__role">{t.role}</span>
            </p>
          </li>
        ))}
      </ul>

      <div class="pager">
        <span class="pager__count"><span data-testi-index>01</span> / {total}</span>
        <span class="pager__arrows">
          <button type="button" class="pager__btn" data-testi-prev aria-label="Previous testimonial">←</button>
          <button type="button" class="pager__btn pager__btn--next" data-testi-next aria-label="Next testimonial">→</button>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .testi { position: relative; z-index: 1; background: #fff; color: #0d221a; }
  .testi__inner {
    min-height: calc(100svh - var(--header-h, 64px));
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 48px;
    padding: 96px 56px;
  }

  /* left: photo rolodex — current photo flat on top, the next ones as tilted strips receding below */
  .rolodex {
    --s: 1; /* scale vs. the 480 px Figma column, set by the script */
    position: relative;
    flex: none;
    width: 480px;
    height: calc(478px * var(--s));
    perspective: 1100px;
    perspective-origin: 50% 100%;
  }
  .rolodex__card {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    aspect-ratio: 480 / 294;
    overflow: hidden;
    background: #d9d9d9;
    transform-origin: 50% 0%;
    backface-visibility: hidden;
    will-change: transform, opacity;
  }
  .rolodex__card img { width: 100%; height: 100%; object-fit: cover; }
  /* the strips darken slightly as they turn away (set by the script) */
  .rolodex__card::after { content: ""; position: absolute; inset: 0; background: #000; opacity: var(--shade, 0); pointer-events: none; }
  .rolodex__fade {
    position: absolute;
    left: 6.5px;
    right: 6.5px;
    bottom: 0;
    height: calc(116px * var(--s));
    background: linear-gradient(180deg, rgba(255, 255, 255, 0), #fff);
    z-index: 50;
    pointer-events: none;
  }

  /* right: quote + person + pager */
  .testi__body {
    flex: 0 1 474px;
    align-self: stretch;
    min-height: calc(478px * var(--s, 1));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
  }
  .testi__quotes { display: grid; margin: 0; padding: 0; list-style: none; flex: 1; }
  .quote {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    visibility: hidden;
  }
  .quote.is-active { visibility: visible; }
  .quote__text { margin: 0; font-size: 24px; line-height: 1.25; letter-spacing: -0.005em; color: #0d221a; }
  .quote__who { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; margin: 0; }
  .quote__name { font-size: 20px; font-weight: 500; line-height: 1.3; color: #141414; }
  .quote__role { font-size: 16px; line-height: 1.5; color: #6b6b70; }

  .pager { display: flex; justify-content: space-between; align-items: center; }
  .pager__count { font-size: 14px; line-height: 1.45; color: #737373; font-variant-numeric: tabular-nums; }
  .pager__arrows { display: flex; gap: 8px; }
  .pager__btn {
    width: 48px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    background: #fff;
    color: #121212;
    font: inherit;
    font-size: 18px;
    cursor: pointer;
    transition: background-color .2s, color .2s, border-color .2s, opacity .2s;
  }
  .pager__btn--next { background: #121212; border-color: #121212; color: #fff; }
  .pager__btn:hover { border-color: #121212; }
  .pager__btn--next:hover { background: #333; }
  .pager__btn:disabled { opacity: .35; cursor: default; }

  @media (max-width: 1100px) {
    .testi__inner { padding: 80px 32px; gap: 40px; }
    .rolodex { width: 400px; }
  }
  @media (max-width: 768px) {
    .testi__inner { flex-direction: column; align-items: stretch; padding: 64px 16px; gap: 24px; }
    .rolodex { width: 100%; }
    .testi__body { flex: none; min-height: 0; }
    .quote__text { font-size: 18px; }
    .quote__name { font-size: 17px; }
    .quote__role { font-size: 14px; }
    .pager__btn { width: 44px; height: 44px; }
  }
</style>

<script>
  import { initTestimonials } from "../scripts/testimonials-motion";
  const cleanup = initTestimonials();
  document.addEventListener("astro:before-swap", () => cleanup?.(), { once: true });
</script>
