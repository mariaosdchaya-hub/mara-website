---
import Icon from "./Icon.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const cases = (await getCollection("cases", ({ data }) => !data.draft && data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
).slice(0, 4); // the deck shows the first 4 featured cases
// the row after the deck shows every case (deck ones included), then a "Let's talk" card
const reel = (await getCollection("cases", ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const allProjects = "https://www.behance.net/mara-bureau";
const count = cases.length;
---
<section class="work" id="work" data-work>
  <div class="work__head">
    <div><p class="sec-label" data-reveal>( Selected work )</p><h2 class="work__title" data-reveal>Selected projects<br />&amp; work</h2></div>
    <p class="work__note" data-reveal>Products we took from idea to shipped — fintech, AI, web3 and SaaS.</p>
  </div>

  <div class="stack" data-stack style={`--count:${count}`}>
    <div class="stack__meta stack__meta--left" aria-hidden="true">
      <span class="stack__label">Project</span>
      <span class="stack__name" data-stack-name>{cases[0]?.data.title}</span>
    </div>
    <div class="stack__meta stack__meta--right" aria-hidden="true">
      <span class="stack__label">Case</span>
      <span class="stack__name" data-stack-index>01</span>
    </div>

    <ul class="stack__stage" role="list">
      {cases.map((c, i) => (
        <li class="card" data-card style={`--i:${i}`}>
          <a class="card__link" href={c.data.link} data-title={c.data.title}>
            <Image
              class="card__img"
              src={c.data.cover}
              alt={c.data.coverAlt}
              widths={[640, 1002, 1504, 2004]}
              sizes="(max-width: 768px) 92vw, 1002px"
              loading={i < 3 ? "eager" : "lazy"}
              decoding="async"
            />
            {c.data.tags.length > 0 && (
              <ul class="card__tags" role="list">
                {c.data.tags.map((t) => <li>{t}</li>)}
              </ul>
            )}
            <div class="card__info">
              <div class="card__text">
                <h3 class="card__title">{c.data.title}</h3>
                <p class="card__summary">{c.data.summary}</p>
              </div>
              <span class="card__arrow" aria-hidden="true">
                <span class="card__arrow-box"><Icon name="Arrow--up-right" size={20} /></span>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <!-- row of compact cards the deck turns into (desktop), or a swipe row (tablet / phone) -->
    <div class="reel" data-reel>
      <ul class="reel__track" role="list" data-reel-track>
        {reel.map((c) => (
          <li class="rcard" data-rcard>
            <a class="rcard__link" href={c.data.link}>
              <Image class="rcard__img" src={c.data.cover} alt={c.data.coverAlt} widths={[400, 640]} sizes="300px" loading="lazy" decoding="async" />
              {c.data.tags.length > 0 && (
                <ul class="rcard__tags" role="list">{c.data.tags.slice(0, 2).map((t) => <li>{t}</li>)}</ul>
              )}
              <span class="rcard__info">
                <span class="rcard__title">{c.data.title}</span>
                <span class="rcard__sum">{c.data.summary}</span>
              </span>
            </a>
          </li>
        ))}
        <li class="rcard rcard--cta" data-rcard>
          <a class="rcard__link" href="#contact">
            <span class="rcard__label">( Let’s talk )</span>
            <span class="rcard__cta">
              <span class="rcard__cta-title">Building something similar?</span>
              <span class="rcard__cta-btn">Let’s talk <Icon name="Arrow--up-right" size={14} /></span>
            </span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="wnav" data-wnav>
    <div class="wnav__progress" aria-hidden="true">
      <span class="wnav__track"><span class="wnav__fill" data-wnav-fill></span></span>
      <span class="wnav__count" data-wnav-count>01 / {String(reel.length + 1).padStart(2, "0")}</span>
    </div>
    <div class="wnav__controls">
      <button type="button" class="wnav__btn" aria-label="Previous project" data-wnav-prev><Icon name="Arrow--left" size={16} /></button>
      <button type="button" class="wnav__btn" aria-label="Next project" data-wnav-next><Icon name="Arrow--right" size={16} /></button>
      <a class="btn-ghost wnav__all" href={allProjects} target="_blank" rel="noopener">View all projects <Icon name="Arrow--up-right" size={14} /></a>
    </div>
  </div>
</section>

<style>
  .work {
    position: relative;
    overflow-x: clip; /* the row runs out to the viewport edge */
    background: #fff;
    color: #0d221a;
    padding: 96px 56px 0;
  }
  .work__head {
    max-width: 1328px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
  }
  .work__title {
    margin: 0;
    font-size: var(--t-h2);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .work__note {
    margin: 0;
    max-width: 380px;
    font-size: var(--t-lead);
    line-height: 1.5;
    color: #6b6b70;
  }

  /* ---------- stack: filing-cabinet deck ---------- */
  .stack {
    --ratio: calc(529 / 1002);
    /* folders are narrower than the page so the row and the lifted card both fit */
    /* Figma: 1002 px card; the group (card + 3 strips ≈ 0.74 × width) must fit the pinned screen */
    --card-w: min(1002px, 70vw, (100svh - var(--header-h, 64px) - 110px) * 1.33);
    position: relative;
    height: calc(100svh - var(--header-h, 64px));
    min-height: 620px;
    max-width: 1328px;
    margin: 0 auto;
  }
  .stack__stage {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    perspective: 1500px;
    perspective-origin: 50% 30%;
    /* flat stacking: cards keep DOM / z-index order, so nearer folders always overlap farther ones */
    transform-origin: 50% 40%;
  }
  .card {
    position: absolute;
    left: 50%;
    top: 0;
    width: var(--card-w);
    aspect-ratio: 1002 / 529;
    margin-left: calc(var(--card-w) / -2);
    transform-origin: 50% 0;
    backface-visibility: hidden;
    will-change: transform;
    box-shadow: 0 10px 24px rgba(0, 0, 0, .16);
  }
  .card__info, .card__tags { transition: opacity .3s ease; }
  .work.is-3d .card:not(.is-lifted) .card__info { opacity: 0; }
  .card__link {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    background: #f6f6f7;
    color: #fff;
    outline-offset: 4px;
  }
  .card__link:focus-visible { outline: 2px solid #0d221a; }
  .card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* depth shade, driven by JS (--shade 0..1) */
  .card__link::after {
    content: "";
    position: absolute;
    inset: 0;
    background: #000;
    opacity: var(--shade, 0);
    pointer-events: none;
  }
  .card__tags {
    position: absolute;
    top: 16px;
    right: 16px;
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card__tags li {
    height: 24px;
    padding: 4px 8px;
    border-radius: 3px;
    background: rgba(0, 0, 0, .33);
    font-size: 12px;
    line-height: 16px;
  }
  .card__info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 43%;
    padding: 28px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }
  .card__info::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, .78) 100%);
    pointer-events: none;
  }
  .card__text { position: relative; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .card__title {
    margin: 0;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .card__summary { margin: 0; color: #bfbfc6; font-size: 14px; line-height: 1.45; }
  .card__arrow-box { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 4px; background: #fff; color: #141414; }
  .card__arrow { position: relative; flex: none; transition: transform .3s cubic-bezier(.2, .7, .2, 1); }
  .card__link:hover .card__arrow { transform: translate(2px, -2px); }

  .stack__meta {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 14px;
    line-height: 1.45;
    z-index: 200;
    pointer-events: none;
  }
  .stack__meta--left { left: 0; }
  .stack__meta--right { right: 0; text-align: right; }

  /* "View all projects" — ghost button; in the pinned frame on desktop, under the deck on smaller screens */
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding: 0 18px;
    border: 1px solid #c9cbcf;
    border-radius: 4px;
    color: #0d221a;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    transition: border-color .2s, background-color .2s;
  }
  .btn-ghost:hover { border-color: #0d221a; background: rgba(13, 34, 26, .03); }
  .btn-ghost :global(svg) { transition: transform .25s cubic-bezier(.2, .7, .2, 1); }
  .btn-ghost:hover :global(svg) { transform: translate(2px, -2px); }
  .stack__label { color: #6b6b70; font-size: 12px; letter-spacing: .04em; text-transform: uppercase; }
  .stack__name { color: #0d221a; }

  /* desktop: the whole section (title, deck, button) pins as one screen under the header;
     the card size follows the height that is left for the deck */
  @media (min-width: 1101px) {
    .work.is-3d {
      display: flex;
      flex-direction: column;
      gap: 12px;
      height: calc(100svh - var(--header-h, 64px));
      min-height: 600px;
      padding: 40px 56px 28px;
    }
    .work.is-3d .work__head { flex: none; width: 100%; }
    .work.is-3d .stack {
      flex: 1 1 0;
      width: 100%;
      height: auto;
      min-height: 0;
      container-type: size;
      --card-w: min(1002px, 100cqw - 320px, 100cqh * 1.3);
    }
  }


  /* ---------- reel: row of compact cards after the deck ---------- */
  .reel { --rc-h: min(252px, 100%); }
  .reel__track { display: flex; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .rcard { flex: none; width: 264px; aspect-ratio: 264 / 252; }
  .rcard__link { position: relative; display: block; height: 100%; overflow: hidden; background: #f6f6f7; color: #fff; }
  .rcard__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2, .7, .2, 1); }
  .rcard__link::after { content: ""; position: absolute; inset: 45% 0 0; background: linear-gradient(to bottom, rgba(0, 0, 0, 0), rgba(0, 0, 0, .78)); }
  .rcard__link:hover .rcard__img { transform: scale(1.04); }
  .rcard__tags { position: absolute; z-index: 1; top: 12px; left: 12px; display: flex; gap: 4px; margin: 0; padding: 0; list-style: none; }
  .rcard__tags li { padding: 3px 6px; border-radius: 2px; background: rgba(20, 20, 20, .45); font-size: 10px; line-height: 1.3; }
  .rcard__info { position: absolute; z-index: 1; left: 16px; right: 16px; bottom: 14px; display: flex; flex-direction: column; gap: 2px; }
  .rcard__title { font-size: 15px; font-weight: 500; }
  .rcard__sum { color: #cfcfd4; font-size: 12px; line-height: 1.4; }
  .rcard__link:focus-visible { outline: 2px solid #79f2ff; outline-offset: 3px; }
  .rcard--cta .rcard__link { display: flex; flex-direction: column; justify-content: space-between; padding: 20px; background: #0d221a; }
  .rcard--cta .rcard__link::after { display: none; }
  .rcard__label { color: #79f2ff; font-size: 12px; letter-spacing: .04em; text-transform: uppercase; }
  .rcard__cta { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .rcard__cta-title { font-size: 20px; line-height: 1.2; max-width: 11em; }
  .rcard__cta-btn { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 4px; background: #79f2ff; color: #141414; font-size: 14px; font-weight: 500; transition: background-color .2s; }
  .rcard--cta .rcard__link:hover .rcard__cta-btn { background: #fff; }

  /* ---------- navigation under the row ---------- */
  .wnav { max-width: 1328px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; gap: 24px; }
  .wnav__progress { display: flex; align-items: center; gap: 16px; }
  .wnav__track { position: relative; display: block; width: 240px; height: 2px; background: #e2e2e6; overflow: hidden; }
  .wnav__fill { position: absolute; inset: 0; background: #0d221a; transform: scaleX(var(--p, 0)); transform-origin: 0 50%; }
  .wnav__count { color: #6b6b70; font-size: 12px; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .wnav__controls { display: flex; align-items: center; gap: 8px; }
  .wnav__btn { display: grid; place-items: center; width: 40px; height: 40px; padding: 0; border: 1px solid #c9cbcf; border-radius: 4px; background: #fff; color: #0d221a; cursor: pointer; transition: border-color .2s, opacity .2s; }
  .wnav__btn:hover { border-color: #0d221a; }
  .wnav__btn:disabled { opacity: .35; cursor: default; border-color: #c9cbcf; }
  .wnav__btn:focus-visible { outline: 2px solid #79f2ff; outline-offset: 2px; }
  .wnav__all { margin-left: 8px; }

  /* desktop deck: the reel waits hidden in the same stage; the nav shows only the button until the row appears */
  .work.is-3d .reel { position: absolute; inset: 0; display: flex; align-items: center; pointer-events: none; opacity: 0; }
  .work.is-3d.is-reel .reel { pointer-events: auto; }
  .work.is-3d .wnav__progress, .work.is-3d .wnav__btn { opacity: 0; visibility: hidden; transition: opacity .3s, visibility .3s; }
  .work.is-3d.is-reel .wnav__progress, .work.is-3d.is-reel .wnav__btn { opacity: 1; visibility: visible; }
  .work.is-3d .wnav { flex: none; width: 100%; }

  /* no deck (tablet, phone, reduced motion): the row is a native swipe row */
  .work:not(.is-3d) .stack__stage, .work:not(.is-3d) .stack__meta { display: none; }
  .work:not(.is-3d) .stack { height: auto; min-height: 0; padding: 32px 0 24px; }
  .work:not(.is-3d) .reel { margin: 0 -56px; padding: 0 56px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding: 0 56px; scrollbar-width: none; }
  .work:not(.is-3d) .reel::-webkit-scrollbar { display: none; }
  .work:not(.is-3d) .rcard { scroll-snap-align: start; }
  .work:not(.is-3d) .wnav { padding-bottom: 96px; }

  @media (max-width: 1100px) {
    .work { padding: 80px 32px 0; }
    .work:not(.is-3d) .reel { margin: 0 -32px; padding: 0 32px; scroll-padding: 0 32px; }
    .work:not(.is-3d) .wnav { padding-bottom: 80px; }
  }
  @media (max-width: 768px) {
    .work { padding: 72px 16px 0; }
    .work__head { flex-direction: column; align-items: flex-start; gap: 16px; }
    .work:not(.is-3d) .reel { margin: 0 -16px; padding: 0 16px; scroll-padding: 0 16px; }
    .rcard { width: 240px; }
    .wnav { gap: 12px; }
    .wnav__track { display: none; }
    .wnav__count { white-space: nowrap; }
    .wnav__btn { width: 36px; height: 36px; }
    .wnav__all { margin-left: 4px; height: 36px; padding: 0 12px; font-size: 13px; }
    .work:not(.is-3d) .wnav { padding-bottom: 72px; }
  }
</style>

<script>
  import { initWorkStack } from "../scripts/work-stack";
  const cleanup = initWorkStack();
  document.addEventListener("astro:before-swap", () => cleanup?.(), { once: true });
</script>
