---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const cases = (await getCollection("cases", ({ data }) => !data.draft && data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
).slice(0, 4); // the homepage shows 4; the rest live behind "View all projects"
const allProjects = "https://www.behance.net/mara-bureau";
const count = cases.length;
---
<section class="work" id="work" data-work>
  <div class="work__head">
    <div><p class="sec-label" data-reveal>( Selected work )</p><h2 class="work__title" data-reveal>Selected projects<br />&amp; work</h2></div>
    <p class="work__note" data-reveal>Products we took from idea to shipped — fintech, AI, web3 and SaaS.</p>
  </div>

  <div class="stack" data-stack style={`--count:${count}`}>
    <div class="stack__meta stack__meta--left" aria-hidden="true">
      <span class="stack__label">Project</span>
      <span class="stack__name" data-stack-name>{cases[0]?.data.title}</span>
    </div>
    <div class="stack__meta stack__meta--right" aria-hidden="true">
      <span class="stack__label">Case</span>
      <span class="stack__name" data-stack-index>01</span>
    </div>

    <a class="btn-ghost stack__all" href={allProjects} target="_blank" rel="noopener">View all projects <span aria-hidden="true">↗</span></a>

    <ul class="stack__stage" role="list">
      {cases.map((c, i) => (
        <li class="card" data-card style={`--i:${i}`}>
          <a class="card__link" href={c.data.link} data-title={c.data.title}>
            <Image
              class="card__img"
              src={c.data.cover}
              alt={c.data.coverAlt}
              widths={[640, 1002, 1504, 2004]}
              sizes="(max-width: 768px) 92vw, 1002px"
              loading={i < 3 ? "eager" : "lazy"}
              decoding="async"
            />
            {c.data.tags.length > 0 && (
              <ul class="card__tags" role="list">
                {c.data.tags.map((t) => <li>{t}</li>)}
              </ul>
            )}
            <div class="card__info">
              <div class="card__text">
                <h3 class="card__title">{c.data.title}</h3>
                <p class="card__summary">{c.data.summary}</p>
              </div>
              <span class="card__arrow" aria-hidden="true">
                <svg width="56" height="56" viewBox="0 0 56 56"><rect width="56" height="56" rx="4" fill="#fff" /><path d="M23.67 33.45l-1.11-1.11 8.24-8.25h-6.37l.02-1.54h8.99v9.01h-1.55l.02-6.37-8.24 8.26z" fill="#141414" /></svg>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="work__all">
    <a class="btn-ghost" href={allProjects} target="_blank" rel="noopener">View all projects <span aria-hidden="true">↗</span></a>
  </div>
</section>

<style>
  .work {
    position: relative;
    background: #fff;
    color: #0d221a;
    padding: 96px 56px 0;
  }
  .work__head {
    max-width: 1328px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
  }
  .work__title {
    margin: 0;
    font-size: var(--t-h2);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .work__note {
    margin: 0;
    max-width: 380px;
    font-size: var(--t-lead);
    line-height: 1.5;
    color: #6b6b70;
  }

  /* ---------- stack: filing-cabinet deck ---------- */
  .stack {
    --ratio: calc(529 / 1002);
    /* folders are narrower than the page so the row and the lifted card both fit */
    /* Figma: 1002 px card; the group (card + 3 strips ≈ 0.74 × width) must fit the pinned screen */
    --card-w: min(1002px, 70vw, (100svh - var(--header-h, 64px) - 110px) * 1.33);
    position: relative;
    height: calc(100svh - var(--header-h, 64px));
    min-height: 620px;
    max-width: 1328px;
    margin: 0 auto;
  }
  .stack__stage {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    perspective: 1500px;
    perspective-origin: 50% 30%;
    /* flat stacking: cards keep DOM / z-index order, so nearer folders always overlap farther ones */
    transform-origin: 50% 40%;
  }
  .card {
    position: absolute;
    left: 50%;
    top: 0;
    width: var(--card-w);
    aspect-ratio: 1002 / 529;
    margin-left: calc(var(--card-w) / -2);
    transform-origin: 50% 0;
    backface-visibility: hidden;
    will-change: transform;
    box-shadow: 0 10px 24px rgba(0, 0, 0, .16);
  }
  .card__info, .card__tags { transition: opacity .3s ease; }
  .work.is-3d .card:not(.is-lifted) .card__info { opacity: 0; }
  .card__link {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    background: #f6f6f7;
    color: #fff;
    outline-offset: 4px;
  }
  .card__link:focus-visible { outline: 2px solid #0d221a; }
  .card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* depth shade, driven by JS (--shade 0..1) */
  .card__link::after {
    content: "";
    position: absolute;
    inset: 0;
    background: #000;
    opacity: var(--shade, 0);
    pointer-events: none;
  }
  .card__tags {
    position: absolute;
    top: 16px;
    right: 16px;
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card__tags li {
    height: 24px;
    padding: 4px 8px;
    border-radius: 3px;
    background: rgba(0, 0, 0, .33);
    font-size: 12px;
    line-height: 16px;
  }
  .card__info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 43%;
    padding: 28px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }
  .card__info::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, .78) 100%);
    pointer-events: none;
  }
  .card__text { position: relative; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .card__title {
    margin: 0;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .card__summary { margin: 0; color: #bfbfc6; font-size: 14px; line-height: 1.45; }
  .card__arrow svg { display: block; width: 40px; height: 40px; }
  .card__arrow { position: relative; flex: none; transition: transform .3s cubic-bezier(.2, .7, .2, 1); }
  .card__link:hover .card__arrow { transform: translate(2px, -2px); }

  .stack__meta {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 14px;
    line-height: 1.45;
    z-index: 200;
    pointer-events: none;
  }
  .stack__meta--left { left: 0; }
  .stack__meta--right { right: 0; text-align: right; }

  /* "View all projects" — ghost button; in the pinned frame on desktop, under the deck on smaller screens */
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding: 0 18px;
    border: 1px solid #c9cbcf;
    border-radius: 4px;
    color: #0d221a;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    transition: border-color .2s, background-color .2s;
  }
  .btn-ghost:hover { border-color: #0d221a; background: rgba(13, 34, 26, .03); }
  .btn-ghost span { transition: transform .25s cubic-bezier(.2, .7, .2, 1); }
  .btn-ghost:hover span { transform: translate(2px, -2px); }
  .stack__all { position: absolute; right: 0; bottom: 32px; z-index: 200; background: #fff; }
  .work__all { display: none; justify-content: center; padding: 40px 0 0; }
  .stack__label { color: #6b6b70; font-size: 12px; letter-spacing: .04em; text-transform: uppercase; }
  .stack__name { color: #0d221a; }

  /* no-JS / reduced motion: simple vertical list */
  .work:not(.is-3d) .stack { height: auto; min-height: 0; padding: 64px 0 120px; }
  .work:not(.is-3d) .stack__stage { position: static; display: grid; gap: 24px; perspective: none; }
  .work:not(.is-3d) .card { position: relative; left: auto; top: auto; margin: 0 auto; width: min(1002px, 100%); }
  .work:not(.is-3d) .stack__meta, .work:not(.is-3d) .stack__all { display: none; }
  .work:not(.is-3d) .work__all { display: flex; }

  @media (max-width: 1100px) {
    .work { padding: 80px 32px 0; }
    .stack__meta, .stack__all { display: none; }
    .work__all { display: flex; }
    .stack { --card-w: min(680px, 70vw, (100svh - var(--header-h, 64px)) * 1.1); }
  }
  @media (max-width: 768px) {
    .work { padding: 72px 16px 0; }
    .work__head { flex-direction: column; align-items: flex-start; gap: 16px; }
    .stack { --ratio: 1.25; --card-w: min(86vw, (100svh - var(--header-h, 64px)) * .46); min-height: 520px; }
    .card { aspect-ratio: 4 / 5; }
    .card__info { padding: 16px; height: 55%; }
    .card__title { font-size: 20px; }
    .card__summary { font-size: 13px; }
    .card__tags { top: 12px; right: 12px; }
    .card__tags li { height: 22px; padding: 3px 7px; font-size: 11px; line-height: 16px; }
    .card__arrow svg { width: 36px; height: 36px; }
  }
</style>

<script>
  import { initWorkStack } from "../scripts/work-stack";
  const cleanup = initWorkStack();
  document.addEventListener("astro:before-swap", () => cleanup?.(), { once: true });
</script>
