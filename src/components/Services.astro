---
// "What we do" — Figma 4202:2753. Image tiles are pre-composited at 2x from the Figma layers
// (inverted stripe render + teal colour blend); see src/assets/services.
import { Image } from "astro:assets";
import s1 from "../assets/services/s1.jpg";
import s2 from "../assets/services/s2.jpg";
import s3 from "../assets/services/s3.jpg";
import s4 from "../assets/services/s4.jpg";
import s5 from "../assets/services/s5.jpg";

type Tile =
  | { kind: "image"; img: ImageMetadata }
  | { kind: "text"; title: string; label: string; tone: "dark" | "ink" | "light" | "teal"; h: number };

const tiles: Tile[] = [
  { kind: "image", img: s1 },
  { kind: "text", title: "Your brand should connect before you explain.", label: "Brand Identity", tone: "ink", h: 366 },
  { kind: "image", img: s2 },
  { kind: "text", title: "Explain what you do in seconds. Turn visitors into customers.", label: "Website & Dev", tone: "light", h: 366 },
  { kind: "image", img: s3 },
  { kind: "text", title: "From first concept to launch-ready. Complexity made simple.", label: "MVP & Product", tone: "teal", h: 371 },
  { kind: "image", img: s4 },
  { kind: "text", title: "Native iOS and Android, from wireframe to App Store.", label: "Mobile App", tone: "dark", h: 420 },
  { kind: "image", img: s5 },
];
---
<section class="services" id="services" data-services>
  <div class="services__inner">
    <div class="services__head">
      <h2 class="services__title">What<br />we do</h2>
      <p class="services__note">Four capabilities, one roof<br />from identity to a shipped product.</p>
    </div>

    <div class="services__viewport">
      <ul class="services__row" role="list" data-services-row>
        {tiles.map((t) =>
          t.kind === "image" ? (
            <li class="tile tile--image" aria-hidden="true">
              <Image src={t.img} alt="" widths={[300, 600]} sizes="300px" loading="lazy" />
            </li>
          ) : (
            <li class={`tile tile--text tile--${t.tone}`} style={`--h:${t.h}px`}>
              <a href="#contact" class="tile__link">
                <p class="tile__title">{t.title}</p>
                <span class="tile__foot">
                  <span class="tile__label">{t.label}</span>
                  <span class="tile__arrow" aria-hidden="true">↗</span>
                </span>
              </a>
            </li>
          ),
        )}
      </ul>
    </div>
  </div>
</section>

<style>
  .services {
    position: relative;
    z-index: 1;
    background: #fff;
    color: #0d221a;
    overflow: hidden;
  }
  .services__inner {
    min-height: calc(100svh - var(--header-h, 64px));
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 56px;
    padding: 96px 0;
  }
  .services__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
    padding: 0 96px 0 56px;
  }
  .services__title {
    margin: 0;
    font-size: 48px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .services__note {
    margin: 0;
    color: #6b6b70;
    font-size: 18px;
    line-height: 1.5;
    letter-spacing: .02em;
    text-transform: uppercase;
  }

  .services__viewport { padding: 0 56px; }
  .services__row {
    display: flex;
    align-items: flex-start;
    gap: 24px;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    will-change: transform;
  }
  .tile { flex: none; width: 300px; overflow: hidden; }
  .tile--image { height: 319px; }
  .tile--image img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .tile--text { height: var(--h); }
  .tile__link {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding: 28px;
  }
  .tile__title { margin: 0; font-size: 24px; font-weight: 500; line-height: 1.25; letter-spacing: -0.005em; }
  .tile__foot { display: flex; justify-content: space-between; align-items: center; }
  .tile__label { opacity: .6; font-size: 12px; line-height: 1.35; letter-spacing: .04em; text-transform: uppercase; }
  .tile__arrow { font-size: 20px; line-height: 1.3; transition: transform .25s cubic-bezier(.2, .7, .2, 1); }
  .tile__link:hover .tile__arrow { transform: translate(3px, -3px); }
  .tile--ink { background: #141416; color: #f0f0f2; }
  .tile--light { background: #f0f0f2; color: #141414; }
  .tile--teal { background: #bdebee; color: #141414; }
  .tile--dark { background: #141414; color: #fff; }

  @media (max-width: 768px) {
    .services__inner { gap: 40px; padding: 72px 0; }
    .services__head { flex-direction: column; gap: 16px; padding: 0 16px; }
    .services__title { font-size: 36px; }
    .services__note { font-size: 14px; }
    .services__viewport { padding: 0 16px; }
    .tile { width: 260px; }
    .tile--image { height: 276px; }
    .tile--text { height: calc(var(--h) * .87); }
    .tile__link { padding: 22px; }
    .tile__title { font-size: 21px; }
  }
  /* no JS / reduced motion: the row simply scrolls sideways */
  .services:not(.is-scrolling) .services__viewport { overflow-x: auto; scrollbar-width: none; }
</style>

<script>
  import { initServices } from "../scripts/services-motion";
  const cleanup = initServices();
  document.addEventListener("astro:before-swap", () => cleanup?.(), { once: true });
</script>
