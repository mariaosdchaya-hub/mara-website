---
import Icon from "./Icon.astro";
// "What we do" — tabs (layout from Figma 4269:2308 "Cut first" tabs card), one tab per capability.
const services = [
  {
    tab: "Brand Identity",
    icon: "Color-palette",
    title: "Your brand should connect before you explain.",
    text: "We build an identity that makes a young company look established: positioning, a visual language and a voice that work everywhere, from the pitch deck to the product UI. Strategy comes first, so every asset has a reason to exist.",
    outputs: ["Positioning and naming direction", "Logo and visual identity system", "Brand guidelines and templates", "Pitch deck and launch assets"],
  },
  {
    tab: "Website & Dev",
    icon: "Application--web",
    title: "Explain what you do in seconds. Turn visitors into customers.",
    text: "Conversion-focused marketing sites, designed and built by the same team. Clear messaging, fast pages and a CMS your team can update without waiting on us.",
    outputs: ["Messaging and page structure", "Responsive website design", "Build in Framer, Webflow or code", "CMS, analytics and SEO setup"],
  },
  {
    tab: "MVP & Product",
    icon: "Layers",
    title: "From first concept to launch-ready. Complexity made simple.",
    text: "We cut the idea down to the one job it has to do, then design and prototype the product around it. Lean scope, real flows and a hand-off engineers can build from on day one.",
    outputs: ["Scope and core user flows", "Clickable prototype", "Product UI and design system", "Dev-ready hand-off and QA"],
  },
  {
    tab: "Mobile App",
    icon: "Application--mobile",
    title: "Native iOS and Android, from wireframe to App Store.",
    text: "Mobile products designed for the platform, not squeezed into it. We follow iOS and Android conventions, design every state and prepare the store listing as well.",
    outputs: ["iOS and Android UI", "Interactive prototype for testing", "Component library and states", "App Store and Google Play assets"],
  },
];
---
<section class="services" id="services" data-services>
  <div class="services__inner">
    <div class="services__head">
      <div>
        <p class="sec-label" data-fade>( Services )</p>
        <h2 class="services__title" data-split>
          <span class="line"><span>What we do</span></span>
        </h2>
      </div>
      <p class="services__note" data-fade>Four capabilities, one roof, from identity to a shipped product.</p>
    </div>

    <div class="tabs-card" data-tabs-card>
      <div class="tabs" role="tablist" aria-label="Services">
        {services.map((s, i) => (
          <button
            type="button"
            class:list={["tab", { "is-active": i === 0 }]}
            role="tab"
            id={`svc-tab-${i}`}
            aria-controls={`svc-panel-${i}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            data-tab
          >
            <span class="tab__bar" aria-hidden="true"></span>
            <span class="tab__label"><span class="tab__num">{String(i + 1).padStart(2, "0")}</span>{s.tab}</span>
          </button>
        ))}
      </div>

      <div class="panels">
        {services.map((s, i) => (
          <div
            class:list={["panel", { "is-active": i === 0 }]}
            role="tabpanel"
            id={`svc-panel-${i}`}
            aria-labelledby={`svc-tab-${i}`}
            inert={i !== 0}
            data-panel
          >
            <div class="panel__left">
              <span class="panel__icon" data-anim><Icon name={s.icon} size={24} /></span>
              <h3 class="panel__title" data-anim>{s.title}</h3>
              <span class="panel__rule" aria-hidden="true"></span>
              <p class="panel__text" data-anim>{s.text}</p>
            </div>
            <div class="panel__right">
              <p class="panel__label" data-anim>Typical outputs:</p>
              <ul class="outputs" role="list">
                {s.outputs.map((o) => (
                  <li class="output" data-anim>
                    <Icon name="Arrow--up-right" size={20} class="output__icon" />
                    {o}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .services { position: relative; z-index: 1; background: #f6f6f7; color: #0d221a; }
  .services__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: var(--sec-pad);
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .services__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; }
  .services__title { margin: 0; font-size: var(--t-h2); font-weight: 400; line-height: 1.1; letter-spacing: -0.02em; }
  .line { display: block; overflow: hidden; padding-bottom: .08em; margin-bottom: -.08em; }
  .line > span { display: inline-block; }
  .services__note {
    margin: 0;
    max-width: 380px;
    color: #6b6b70;
    font-size: var(--t-lead);
    line-height: 1.5;
  }

  .tabs-card { background: #fff; border: 1px solid #e6e6e9; overflow: hidden; }
  .tabs { display: flex; background: #f2f2f4; }
  .tab {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: 0;
    border: 0;
    background: #f2f2f4;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background-color .3s ease;
  }
  .tab__bar { display: block; height: 2px; background: #79f2ff; transform: scaleX(0); transform-origin: 0 50%; transition: transform .45s cubic-bezier(.2, .7, .2, 1); }
  .tab__label {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 15px 24px;
    font-size: 15px;
    font-weight: 500;
    color: #6b6b70;
    white-space: nowrap;
    transition: color .3s ease;
  }
  .tab__num { font-weight: 400; color: #9999a1; transition: color .3s ease; }
  .tab:hover .tab__label { color: #141414; }
  .tab.is-active { background: #fff; }
  .tab.is-active .tab__bar { transform: scaleX(1); }
  .tab.is-active .tab__label, .tab.is-active .tab__num { color: #141414; }
  .tab:focus-visible { outline: 2px solid #0d221a; outline-offset: -2px; }

  .panels { display: grid; }
  .panel { grid-area: 1 / 1; display: flex; background: #fff; }
  /* all panels share one cell so the card keeps the height of the tallest one */
  .panel:not(.is-active) { visibility: hidden; }
  .panel__left {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding: 40px;
    border-right: 1px solid #e6e6e9;
  }
  .panel__icon { display: grid; place-items: center; width: 48px; height: 48px; background: #0d221a; color: #fff; }
  .output :global(.output__icon) { color: #9e9ea8; }
  .panel__title { margin: 0; font-size: 18px; font-weight: 500; line-height: 1.3; color: #141414; }
  .panel__rule { align-self: stretch; height: 1px; background: #e6e6e9; }
  .panel__text { margin: 0; max-width: 560px; font-size: var(--t-text); line-height: 1.5; color: #6b6b70; }
  .panel__right { flex: 0 0 420px; padding: 40px; }
  .panel__label { margin: 0; font-size: 13px; line-height: 1.2; color: #6b6b70; }
  .outputs { margin: 0; padding: 0; list-style: none; }
  .output {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 0;
    font-size: 16px;
    font-weight: 400;
    color: #141414;
  }
  .output:first-child { padding-top: 20px; }
  .output + .output { border-top: 1px solid #e6e6e9; }
  .output :global(svg) { flex: none; }

  @media (max-width: 1100px) {
    .services__head { flex-direction: column; align-items: flex-start; }
    .services__note { padding: 0; }
    .tab__label { padding: 14px 18px; font-size: 14px; }
    .panel__right { flex-basis: 380px; padding: 40px 32px; }
    .panel__left { padding: 40px 32px 48px; }
  }
  @media (max-width: 768px) {
    .services__inner { gap: 32px; }
    .tabs { overflow-x: auto; scrollbar-width: none; scroll-snap-type: x mandatory; }
    .tabs::-webkit-scrollbar { display: none; }
    .tab { flex: 0 0 auto; scroll-snap-align: start; }
    .tab__label { padding: 12px 16px; font-size: 13px; }
    .panel { flex-direction: column; }
    .panel__left { padding: 28px 20px 32px; gap: 20px; border-right: 0; border-bottom: 1px solid #e6e6e9; }
    .panel__right { flex-basis: auto; padding: 28px 20px; }
    .output { font-size: 15px; padding: 14px 0; }
    .output:first-child { padding-top: 16px; }
  }
</style>

<script>
  import { initServices } from "../scripts/services-motion";
  const cleanup = initServices();
  document.addEventListener("astro:before-swap", () => cleanup?.(), { once: true });
</script>
