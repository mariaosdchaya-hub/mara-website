---
// Contact popup — every "#contact" CTA opens it, so visitors don't lose their place on the page.
import ContactPanel from "./ContactPanel.astro";
---
<dialog class="cmodal" aria-labelledby="cp-title" data-cmodal>
  <div class="cmodal__bg" aria-hidden="true"></div>
  <button type="button" class="cmodal__close" aria-label="Close" data-c-close>
    <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.6" /></svg>
  </button>
  <div class="cmodal__inner">
    <ContactPanel context="popup" />
  </div>
</dialog>

<style>
  .cmodal {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #000100;
    color: #fff;
    overflow: hidden auto;
    overscroll-behavior: contain;
    opacity: 0;
    transition: opacity .35s ease, display .35s allow-discrete, overlay .35s allow-discrete;
  }
  .cmodal[open] { opacity: 1; }
  @starting-style { .cmodal[open] { opacity: 0; } }
  .cmodal::backdrop { background: rgba(0, 0, 0, .6); }
  .cmodal__bg { position: fixed; inset: 0; background: #000100 url("/contact/contact-bg.jpg") no-repeat 50% 100% / cover; pointer-events: none; }
  .cmodal__inner {
    position: relative;
    min-height: 100%;
    display: flex;
    align-items: center;
    padding: 72px 56px 40px;
  }
  .cmodal[open] .cmodal__inner { animation: cmodal-in .6s cubic-bezier(.2, .7, .2, 1); }
  /* transform only: animating opacity here turns the wrapper into a backdrop root and the card's blur stops working */
  @keyframes cmodal-in { from { transform: translateY(28px); } to { transform: none; } }
  /* in the popup the card sits right over the bright lines: keep it near-solid so nothing shows through */
  .cmodal :global(.cpanel__card) { background: rgba(18, 18, 20, .94); }
  .cmodal__close {
    position: fixed;
    top: 24px;
    right: 24px;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, .2);
    border-radius: 4px;
    background: rgba(18, 18, 20, .6);
    color: #fff;
    cursor: pointer;
    transition: background-color .2s, border-color .2s;
  }
  .cmodal__close:hover { background: rgba(255, 255, 255, .1); border-color: rgba(255, 255, 255, .5); }
  .cmodal__close:focus-visible { outline: 2px solid #79f2ff; outline-offset: 2px; }
  @media (max-width: 1100px) { .cmodal__inner { padding: 88px 32px 56px; } }
  @media (max-width: 768px) {
    .cmodal__inner { padding: 72px 16px 32px; }
    .cmodal__bg { background-image: url("/contact/contact-bg-sm.jpg"); background-size: 900px auto; }
    .cmodal__close { top: 14px; right: 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cmodal, .cmodal[open] .cmodal__inner { transition: none; animation: none; }
  }
</style>

<script>
  import { initContact } from "../scripts/contact";
  initContact();
</script>
