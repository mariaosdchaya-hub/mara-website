---
// FAQ — Figma 4202:2943. Answers from mara.ink; the pricing answer follows the calculator's minimums.
const faqs = [
  {
    q: "How much does a project cost?",
    a: "It depends on scope, timeline and your specific needs. Landing pages start from $2k and MVPs from $3.5k. Use the calculator above for a ballpark, and once we align on scope we give you a clear, detailed quote.",
  },
  {
    q: "We've been burned by agencies before. How are you different?",
    a: "We don't do 6-week discovery phases, 40-slide decks or design-by-committee. You get a senior team that embeds into your workflow, makes decisions and ships. No account managers, no endless loops: you talk directly to the people who do the work.",
  },
  {
    q: "We have a tight deadline. Can you actually hit it?",
    a: "Yes, if it's realistic, we'll commit to it. If it's not, we'll tell you upfront and propose what's achievable. We've never missed a deadline we've agreed to.",
  },
  {
    q: "Do we need a detailed brief to start?",
    a: "No. Some of our best projects started with a Loom video and a rough idea. We'll ask the right questions, shape the brief with you and get moving fast. You don't need to have it all figured out, that's part of what we do.",
  },
  {
    q: "What if I only need help with one thing?",
    a: "That's totally fine. Some clients come to us for a full build, others just need a brand or a website. We'll scope it based on what actually makes sense for you.",
  },
  {
    q: "What industries do you work with?",
    a: "Mostly teams building complex products: Web3, SaaS, AI, Fintech, Healthtech, EdTech, plus plenty of service businesses and local providers. Dashboards, token platforms, AI tools, patient portals: if it's complicated, we've probably untangled something similar.",
  },
];
---
<section class="faq" id="faq" data-faq>
  <div class="faq__inner">
    <div class="faq__head">
      <h2 class="faq__title" data-split>
        <span class="line"><span>Questions,</span></span>
        <span class="line"><span>answered</span></span>
      </h2>
      <p class="faq__note" data-fade>The things founders<br />ask us before starting.</p>
    </div>

    <ul class="faq__list" role="list">
      {faqs.map((f, i) => (
        <li class:list={["faq__item", { "is-open": i === 0 }]} data-faq-item>
          <h3 class="faq__q">
            <button type="button" class="faq__btn" aria-expanded={i === 0 ? "true" : "false"} aria-controls={`faq-a-${i}`} id={`faq-q-${i}`} data-faq-btn>
              <span>{f.q}</span>
              <span class="faq__icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="faq__panel" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
            <div class="faq__panel-inner">
              <p class="faq__a">{f.a}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .faq { position: relative; z-index: 1; background: #fff; color: #0d221a; }
  .faq__inner { max-width: 1440px; margin: 0 auto; padding: 96px 56px; display: flex; gap: 80px; align-items: flex-start; }
  .faq__head { flex: 0 0 440px; display: flex; flex-direction: column; gap: 24px; position: sticky; top: calc(var(--header-h, 64px) + 40px); }
  .faq__title { margin: 0; font-size: 48px; font-weight: 400; line-height: 1; letter-spacing: -0.02em; }
  .faq__title .line + .line { margin-top: 8px; }
  .line { display: block; overflow: hidden; padding-bottom: .08em; margin-bottom: -.08em; }
  .line > span { display: inline-block; }
  .faq__note { margin: 0; color: #6b6b70; font-size: 18px; line-height: 1.5; letter-spacing: .02em; text-transform: uppercase; }

  .faq__list { flex: 1 1 0; min-width: 0; margin: 0; padding: 0; list-style: none; border-bottom: 1px solid #e6e6e9; }
  .faq__item { border-top: 1px solid #e6e6e9; }
  .faq__q { margin: 0; font: inherit; }
  .faq__btn {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    width: 100%;
    padding: 26px 0;
    border: 0;
    background: none;
    color: #141414;
    font: inherit;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
    text-align: left;
    cursor: pointer;
    transition: color .2s;
  }
  .faq__btn:hover { color: #0d221a; }
  .faq__btn:hover .faq__icon::before, .faq__btn:hover .faq__icon::after { background: #141414; }
  .faq__btn:focus-visible { outline: 2px solid #79f2ff; outline-offset: 4px; }
  .faq__item.is-open .faq__btn { padding-bottom: 16px; }

  /* plus that turns into a minus */
  .faq__icon { position: relative; flex: none; width: 14px; height: 14px; }
  .faq__icon::before, .faq__icon::after {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 1.5px;
    margin-top: -.75px;
    background: #6b6b70;
    transition: transform .35s cubic-bezier(.2, .7, .2, 1), background-color .2s;
  }
  .faq__icon::after { transform: rotate(90deg); }
  .faq__item.is-open .faq__icon::after { transform: rotate(0deg); }

  .faq__panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .4s cubic-bezier(.2, .7, .2, 1); }
  .faq__panel-inner { overflow: hidden; min-height: 0; }
  .faq__item.is-open .faq__panel { grid-template-rows: 1fr; }
  .faq__a {
    margin: 0;
    padding: 0 200px 26px 0;
    color: #6b6b70;
    font-size: 16px;
    line-height: 1.5;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity .3s ease, transform .4s cubic-bezier(.2, .7, .2, 1);
  }
  .faq__item.is-open .faq__a { opacity: 1; transform: none; transition-delay: .08s; }

  @media (max-width: 1100px) {
    .faq__inner { flex-direction: column; gap: 40px; padding: 80px 32px; }
    .faq__head { position: static; flex-basis: auto; }
    .faq__list { width: 100%; }
    .faq__a { padding-right: 48px; }
  }
  @media (max-width: 768px) {
    .faq__inner { padding: 72px 16px; }
    .faq__title { font-size: 36px; }
    .faq__note { font-size: 14px; }
    .faq__btn { padding: 20px 0; font-size: 17px; }
    .faq__a { padding: 0 0 20px; font-size: 15px; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>("[data-faq]");
  if (section) {
    const items = Array.from(section.querySelectorAll<HTMLElement>("[data-faq-item]"));
    // one answer open at a time; clicking the open one closes it
    items.forEach((item) => {
      const btn = item.querySelector<HTMLButtonElement>("[data-faq-btn]")!;
      btn.addEventListener("click", () => {
        const open = !item.classList.contains("is-open");
        items.forEach((other) => {
          other.classList.remove("is-open");
          other.querySelector("[data-faq-btn]")!.setAttribute("aria-expanded", "false");
        });
        if (open) {
          item.classList.add("is-open");
          btn.setAttribute("aria-expanded", "true");
        }
      });
    });

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      gsap
        .timeline({ scrollTrigger: { trigger: section, start: "top 78%", toggleActions: "play none none reverse" } })
        .fromTo(
          section.querySelectorAll("[data-split] .line > span"),
          { yPercent: 105, opacity: 0, filter: "blur(8px)" },
          { yPercent: 0, opacity: 1, filter: "blur(0px)", duration: 0.75, stagger: 0.09, ease: "power3.out" },
        )
        .fromTo(section.querySelectorAll("[data-fade]"), { opacity: 0, filter: "blur(6px)" }, { opacity: 1, filter: "blur(0px)", duration: 0.6 }, 0.1)
        .fromTo(items, { y: 18, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, stagger: 0.06, ease: "power2.out" }, 0.15);
    }
  }
</script>
