---
import Icon from "./Icon.astro";
const nav = [
  { label: "Home", href: "/", caret: true },
  { label: "Blog", href: "#", caret: true },
  { label: "Work", href: "#work", caret: false },
  { label: "Contact us", href: "#contact", caret: true },
];
---
<header class="header">
  <div class="header__left">
    <a href="/" class="header__logo" aria-label="Mara home">
      <img src="/logo.svg" alt="Mara" width="89" height="20" />
    </a>
    <nav class="header__nav" aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} class="header__link">
          {item.label}
          {item.caret && (
            <Icon name="Chevron--down" size={14} />
          )}
        </a>
      ))}
    </nav>
  </div>

  <div class="header__right">
    <div class="header__social">
      <a href="https://www.behance.net/mara-bureau" target="_blank" rel="noopener">
        <img src="/icons/behance.svg" alt="" width="16" height="16" />Behance
      </a>
      <a href="https://dribbble.com/" target="_blank" rel="noopener">
        <img src="/icons/dribbble.svg" alt="" width="16" height="16" />Dribbble
      </a>
    </div>
    <div class="header__cta">
      <a href="#work" class="btn btn--sm btn--ghost">View work</a>
      <a href="#contact" class="btn btn--sm btn--primary">Let's talk</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--gutter);
    background: rgba(0, 0, 0, .8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--c-charcoal);
  }
  .header__left { display: flex; align-items: center; gap: 92px; }
  .header__logo img { width: 86px; height: auto; }
  .header__nav { display: flex; align-items: center; gap: 16px; }
  .header__link {
    display: inline-flex; align-items: center; gap: 1px;
    font-size: var(--t-body); line-height: 1.5;
    color: var(--c-white);
    transition: color .2s;
  }
  .header__link:hover { color: var(--c-gray-350); }
  .header__right { display: flex; align-items: center; gap: 32px; }
  .header__social { display: flex; gap: 16px; }
  .header__social a {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: var(--t-small); line-height: 1.45;
    transition: opacity .2s;
  }
  .header__social a:hover { opacity: .7; }
  .header__cta { display: flex; gap: 8px; }

  @media (max-width: 1100px) {
    .header__left { gap: 48px; }
    .header__social { display: none; }
  }
  @media (max-width: 860px) {
    .header__nav { display: none; }
  }
  @media (max-width: 480px) {
    .header { padding: 0 16px; }
    .header__cta .btn--ghost { display: none; }
  }
</style>
