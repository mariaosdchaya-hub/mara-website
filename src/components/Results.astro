---
// "Trusted across borders" — Figma 4207:4817.
import { Image } from "astro:assets";
import globe from "../assets/results/globe.png";

const stats = [
  { label: "Raised & earned", prefix: "$", value: 30, unit: "M", suffix: "+" },
  { label: "Companies", prefix: "", value: 100, unit: "", suffix: "+" },
  { label: "Years shipping", prefix: "", value: 4, unit: "", suffix: "+" },
  { label: "Partnerships 8mo+", prefix: "", value: 65, unit: "", suffix: "%" },
];
const regions = [
  { name: "North America", list: "United States, Canada" },
  { name: "Europe", list: "UK, Germany, Netherlands, France, Spain, Switzerland, Austria, Poland, Ukraine" },
  { name: "Middle East", list: "United Arab Emirates, Saudi Arabia" },
  { name: "Asia-Pacific", list: "Singapore, Hong Kong, Australia" },
];
---
<section class="results" id="results" data-results>
  <div class="results__head">
  <h2 class="results__title" data-split>
    <span class="line"><span>Trusted</span></span>
    <span class="line"><span>across borders</span></span>
  </h2>

  <ul class="stats" role="list">
    {stats.map((s) => (
      <li class="stat" data-stat>
        <span class="stat__top">
          <span class="stat__label">{s.label}</span>
          <span class="stat__dot" aria-hidden="true" data-stat-dot></span>
        </span>
        <span class="stat__value">
          <span class="stat__num">{s.prefix}<span data-count={s.value}>{s.value}</span>{s.unit}</span>
          <span class="stat__suffix">{s.suffix}</span>
        </span>
      </li>
    ))}
  </ul>
  </div>

  <div class="globe" aria-hidden="true" data-globe>
    <div class="globe__img" data-globe-img>
      <Image src={globe} alt="" widths={[800, 1245, 2000]} sizes="(max-width: 768px) 150vw, 1245px" loading="lazy" />
    </div>
    <div class="globe__vignette"></div>
  </div>

  <div class="world" data-world>
    <p class="world__title" data-world-title>( Where we work )</p>
    <div class="world__cols">
      {regions.map((r) => (
        <div class="world__col">
          <p class="world__region">{r.name}</p>
          <p class="world__list">{r.list}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* desktop: the whole section fits one screen under the header —
     title and stats share a row, the globe takes whatever height is left */
  .results {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 28px;
    height: calc(100svh - var(--header-h, 64px));
    min-height: 640px;
    padding: 48px 56px;
    overflow: hidden;
    background: #fff;
    color: #0d221a;
  }
  .results > * { width: 100%; max-width: 1328px; margin-left: auto; margin-right: auto; }

  .results__head { position: relative; z-index: 2; display: flex; align-items: flex-end; gap: 48px; flex: none; }
  .results__title { flex: none; margin: 0; font-size: var(--t-h2); font-weight: 400; line-height: 1.1; letter-spacing: -0.02em; }
  .line { display: block; overflow: hidden; padding-bottom: .08em; margin-bottom: -.08em; }
  .line > span { display: inline-block; }

  .stats { flex: 1; display: flex; gap: 16px; margin: 0; padding: 0; list-style: none; position: relative; z-index: 2; }
  .stat {
    flex: 1 1 0;
    min-width: 0;
    height: 112px;
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: #f6f6f7;
  }
  .stat__top { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .stat__label {
    overflow: hidden;
    color: #6b6b70;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: .06em;
    text-transform: uppercase;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .stat__dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d9d9de;
    transition: background-color .4s ease, box-shadow .6s ease;
  }
  .stat.is-done .stat__dot { background: #2fd6e6; box-shadow: 0 0 0 4px rgba(121, 242, 255, .35); }
  .stat__value { display: flex; align-items: flex-start; gap: 3px; color: #141414; white-space: nowrap; }
  .stat__num { font-size: 36px; font-weight: 400; line-height: .9; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .stat__suffix { margin-top: 1px; font-size: 16px; font-weight: 400; line-height: 1; color: #6b6b70; }

  /* globe: fills the gap between the stats and the dark card and runs under the card.
     Its width follows the gap height so the same part of the map shows (Figma: 499 of 934 px above the card) */
  .globe { position: relative; z-index: 0; flex: 1 1 0; min-height: 120px; container-type: size; }
  /* the map sinks into white just above the regions row instead of hitting a wall */
  .globe::after { content: ""; position: absolute; left: -50vw; right: -50vw; bottom: -4px; height: 144px; background: linear-gradient(to bottom, rgba(255, 255, 255, 0), #fff 75%); pointer-events: none; z-index: 2; }
  .globe__img, .globe__vignette { --gw: min(1245px, 150vw, 100cqh * 1245 / 499); }
  .globe__img {
    position: absolute;
    left: 50%;
    top: calc(var(--gw) * -73 / 1245);
    width: var(--gw);
    aspect-ratio: 1245 / 934;
    transform: translateX(-50%);
  }
  .globe__img img { width: 100%; height: 100%; object-fit: cover; }
  /* scroll reveal: a soft circle opens from the middle of the map (--r is scrubbed in results-motion.ts) */
  .globe__img {
    -webkit-mask-image: radial-gradient(circle at 50% 58%, #000 var(--r, 100%), transparent calc(var(--r, 100%) + 18%));
            mask-image: radial-gradient(circle at 50% 58%, #000 var(--r, 100%), transparent calc(var(--r, 100%) + 18%));
  }
  .globe__vignette {
    position: absolute;
    left: 50%;
    top: calc(var(--gw) * -254 / 1245);
    width: calc(var(--gw) * 1389 / 1245);
    height: calc(var(--gw) * 1134 / 1245);
    transform: translateX(-50%);
    /* Figma uses a grey gradient in "screen" mode; on white that equals this white fade (alpha = a × v) */
    background: radial-gradient(ellipse 47.9% 50% at 50% 50%, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, .0625) 25%, rgba(255, 255, 255, .25) 50%, rgba(255, 255, 255, .5625) 75%, #fff 100%);
    pointer-events: none;
  }

  .world {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    flex: none;
    gap: 16px;
  }
  /* solid white from just above the row to the bottom of the section: the map never shows below the fade */
  .world::before { content: ""; position: absolute; z-index: -1; left: -100vw; right: -100vw; top: -30px; bottom: -400px; background: #fff; }
  .world__title { margin: 0; color: #6b6b70; font-size: 12px; font-weight: 400; letter-spacing: .04em; text-transform: uppercase; }
  .world__cols { display: flex; gap: 24px; }
  .world__col { flex: 1 1 0; display: flex; flex-direction: column; gap: 6px; padding-top: 14px; border-top: 1px solid #e2e2e6; }
  .world__region { margin: 0; color: #141414; font-size: 15px; font-weight: 500; line-height: 1.3; }
  .world__list { margin: 0; color: #6b6b70; font-size: 13px; line-height: 1.45; max-width: 26em; }

  @media (max-width: 1360px) {
    .results__head { gap: 40px; }
    .stats { gap: 12px; }
    .stat { padding: 16px 16px 18px; }
    .stat__label { letter-spacing: .03em; }
  }
  @media (max-width: 1100px) {
    /* stacked layout scrolls normally */
    .results { height: auto; min-height: 0; padding: 80px 32px; gap: 32px; }
    .results__head { flex-direction: column; align-items: stretch; gap: 32px; }
    .globe { flex: none; height: 300px; }
    .stats { flex-wrap: wrap; }
    .stat { flex: 1 1 calc(50% - 12px); }
  }
  @media (max-width: 768px) {
    .results { padding: 72px 16px; gap: 32px; }
    .stats { gap: 12px; }
    .stat { flex-basis: calc(50% - 6px); height: 100px; padding: 14px 14px 16px; }
    .globe { height: 220px; }
    .stat__label { font-size: 10px; letter-spacing: .05em; }
    .stat__num { font-size: 32px; }
    .stat__suffix { font-size: 14px; }
    .world { gap: 16px; }
    .world__cols { flex-wrap: wrap; gap: 12px 16px; }
    .world__cols { gap: 20px 16px; }
    .world__col { flex: 1 1 calc(50% - 8px); padding-top: 12px; }
    .world__list { font-size: 13px; }
  }
</style>

<script>
  import { initResults } from "../scripts/results-motion";
  const cleanup = initResults();
  document.addEventListener("astro:before-swap", () => cleanup?.(), { once: true });
</script>
