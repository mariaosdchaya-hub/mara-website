---
// "Trusted across borders" — Figma 4207:4817.
import { Image } from "astro:assets";
import globe from "../assets/results/globe.png";

const stats = [
  { label: "Raised & earned", prefix: "$", value: 30, unit: "M", suffix: "+" },
  { label: "Companies", prefix: "", value: 100, unit: "", suffix: "+" },
  { label: "Years shipping", prefix: "", value: 4, unit: "", suffix: "+" },
  { label: "Partnerships 8mo+", prefix: "", value: 65, unit: "", suffix: "%" },
];
const countries = [
  ["United States", "United Kingdom", "Netherlands", "Germany"],
  ["France", "Spain", "Switzerland", "Austria"],
  ["United Arab Emirates", "Saudi Arabia", "Hong Kong", "Singapore"],
  ["Canada", "Australia", "Ukraine", "Poland"],
];
---
<section class="results" id="results" data-results>
  <h2 class="results__title" data-split>
    <span class="line"><span>Trusted</span></span>
    <span class="line"><span>across borders</span></span>
  </h2>

  <ul class="stats" role="list">
    {stats.map((s) => (
      <li class="stat" data-stat>
        <span class="stat__top">
          <span class="stat__label">{s.label}</span>
          <span class="stat__dot" aria-hidden="true" data-stat-dot></span>
        </span>
        <span class="stat__value">
          <span class="stat__num">{s.prefix}<span data-count={s.value}>{s.value}</span>{s.unit}</span>
          <span class="stat__suffix">{s.suffix}</span>
        </span>
      </li>
    ))}
  </ul>

  <div class="globe" aria-hidden="true" data-globe>
    <div class="globe__img" data-globe-img>
      <Image src={globe} alt="" widths={[800, 1245, 2000]} sizes="(max-width: 768px) 150vw, 1245px" loading="lazy" />
    </div>
    <div class="globe__vignette"></div>
  </div>

  <div class="world" data-world>
    <p class="world__title" data-world-title>We are worldwide</p>
    <div class="world__cols">
      {countries.map((col) => (
        <ul class="world__col" role="list">
          {col.map((c) => <li data-country>{c}</li>)}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  .results {
    /* globe width; every globe offset below is a fraction of it (Figma: 1245 px wide) */
    --gw: min(1245px, 150vw);
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 96px 56px;
    overflow: hidden;
    background: #fff;
    color: #0d221a;
  }
  .results > * { width: 100%; max-width: 1328px; margin-left: auto; margin-right: auto; }

  .results__title { margin: 0; font-size: 56px; font-weight: 400; line-height: 1; letter-spacing: -0.02em; }
  .line { display: block; overflow: hidden; padding-bottom: .08em; margin-bottom: -.08em; }
  .line > span { display: inline-block; }

  .stats { display: flex; gap: 24px; margin: 0; padding: 0; list-style: none; position: relative; z-index: 2; }
  .stat {
    flex: 1 1 0;
    min-width: 0;
    height: 200px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: #f6f6f7;
  }
  .stat__top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .stat__label { color: #6b6b70; font-size: 13px; letter-spacing: .02em; text-transform: uppercase; }
  .stat__dot {
    flex: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #ededef;
    border: 1px solid #e6e6e9;
    transition: background-color .4s ease, border-color .4s ease, box-shadow .6s ease;
  }
  .stat.is-done .stat__dot { background: #79f2ff; border-color: #79f2ff; box-shadow: 0 0 0 6px rgba(121, 242, 255, .25); }
  .stat__value { display: flex; align-items: flex-start; gap: 2px; color: #141414; font-weight: 500; white-space: nowrap; }
  .stat__num { font-size: 56px; line-height: 1; font-variant-numeric: tabular-nums; }
  .stat__suffix { font-size: 24px; }

  /* globe: sits in the gap between the stats and the dark card and runs under the card */
  .globe { position: relative; z-index: 0; height: calc(var(--gw) * 426 / 1245); }
  .globe__img {
    position: absolute;
    left: 50%;
    top: calc(var(--gw) * -73 / 1245);
    width: var(--gw);
    aspect-ratio: 1245 / 934;
    transform: translateX(-50%);
  }
  .globe__img img { width: 100%; height: 100%; object-fit: cover; }
  /* scroll reveal: a soft circle opens from the middle of the map (--r is scrubbed in results-motion.ts) */
  .globe__img {
    -webkit-mask-image: radial-gradient(circle at 50% 58%, #000 var(--r, 100%), transparent calc(var(--r, 100%) + 18%));
            mask-image: radial-gradient(circle at 50% 58%, #000 var(--r, 100%), transparent calc(var(--r, 100%) + 18%));
  }
  .globe__vignette {
    position: absolute;
    left: 50%;
    top: calc(var(--gw) * -254 / 1245);
    width: calc(var(--gw) * 1389 / 1245);
    height: calc(var(--gw) * 1134 / 1245);
    transform: translateX(-50%);
    /* Figma uses a grey gradient in "screen" mode; on white that equals this white fade (alpha = a × v) */
    background: radial-gradient(ellipse 47.9% 50% at 50% 50%, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, .0625) 25%, rgba(255, 255, 255, .25) 50%, rgba(255, 255, 255, .5625) 75%, #fff 100%);
    pointer-events: none;
  }

  .world {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 40px;
    background: #141414;
    border: 1px solid rgba(0, 0, 0, .09);
  }
  .world__title { margin: 0; color: #fff; font-size: 36px; }
  .world__cols { display: flex; gap: 24px; }
  .world__col { flex: 1 1 0; display: flex; flex-direction: column; gap: 16px; margin: 0; padding: 0; list-style: none; color: #f6f6f7; font-size: 18px; }

  @media (max-width: 1100px) {
    .results { padding: 80px 32px; }
    .stats { flex-wrap: wrap; }
    .stat { flex: 1 1 calc(50% - 12px); }
  }
  @media (max-width: 768px) {
    .results { padding: 72px 16px; gap: 32px; }
    .results__title { font-size: 40px; }
    .stats { gap: 12px; }
    .stat { flex-basis: calc(50% - 6px); height: 150px; padding: 18px; }
    .stat__label { font-size: 11px; }
    .stat__dot { width: 14px; height: 14px; }
    .stat__num { font-size: 36px; }
    .stat__suffix { font-size: 18px; }
    .world { padding: 24px; gap: 20px; }
    .world__title { font-size: 26px; }
    .world__cols { flex-wrap: wrap; gap: 12px 16px; }
    .world__col { flex: 1 1 calc(50% - 8px); gap: 12px; font-size: 15px; }
  }
</style>

<script>
  import { initResults } from "../scripts/results-motion";
  const cleanup = initResults();
  document.addEventListener("astro:before-swap", () => cleanup?.(), { once: true });
</script>
